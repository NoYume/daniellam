---
import ArrowRight from '@phosphor-icons/core/light/arrow-right-light.svg';
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';
import { getOrdered } from '../lib/content';
import SectionTitle from './SectionTitle.astro';

const site = (await getEntry('site', 'site'))!.data;
// The photos marked `teaser: true`, in page order (the content check makes sure there are four).
const photos = (await getOrdered('shots')).flatMap((trip) => trip.data.photos.filter((photo) => photo.teaser));
---

<section id="shots">
  <div class="wrap">
    <SectionTitle zh="攝影" title="Shots" />
    <div class="shots-head">
      <p class="sec-sub shots-sub">{site.subtitles.shots}</p>
      <a class="lt shots-all" href="/shots/">See all shots<ArrowRight aria-hidden="true" /></a>
    </div>
    <div class="shots-row">
      {
        photos.map((photo) => (
          <figure class="shot">
            <div class="frame">
              <Picture
                src={photo.file}
                alt={photo.alt}
                formats={['avif', 'webp']}
                width={960}
                widths={[480, 720, 960]}
                sizes="(max-width: 900px) 50vw, 25vw"
                loading="lazy"
              />
            </div>
            {photo.credit && <figcaption>Photo: {photo.credit}</figcaption>}
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initShots } from '../scripts/shots';
  initShots();
</script>

<style>
  /* The subtitle, with "See all shots" at the right of its line (below it on phones). */
  .shots-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 14px 40px;
    margin-bottom: 36px;
  }
  .shots-sub {
    margin-bottom: 0;
  }
  .shots-all {
    flex: none;
    font-family: var(--font-mono);
    font-size: 14.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .shots-all :global(svg) {
    display: inline-block;
    width: 1em;
    height: 1em;
    margin-left: 8px;
    vertical-align: -0.14em;
  }
  /* Grayscale until hover (or, on touch screens, until the middle of the screen). */
  .shots-row {
    display: grid;
    grid-template-columns: 1.35fr 0.75fr 1fr 1.2fr;
    gap: 14px;
  }
  .frame {
    overflow: hidden;
    border-radius: var(--r);
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: 360px;
    object-fit: cover;
    filter: var(--shot-filter);
    transition:
      filter 0.5s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .shot:hover .frame :global(img),
  .shot.in-view .frame :global(img) {
    filter: none;
    transform: scale(1.05);
  }
  figcaption {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 10px;
  }
  @media (prefers-reduced-motion: reduce) {
    .shot:hover .frame :global(img),
    .shot.in-view .frame :global(img) {
      transform: none;
    }
  }
  @media (max-width: 900px) {
    .shots-head {
      flex-direction: column;
      align-items: flex-start;
    }
    .shots-row {
      grid-template-columns: 1fr 1fr;
    }
    .frame :global(img) {
      height: 220px;
    }
  }
</style>

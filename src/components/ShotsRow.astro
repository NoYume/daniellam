---
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';
import { getOrdered } from '../lib/content';
import SectionTitle from './SectionTitle.astro';

const site = (await getEntry('site', 'site'))!.data;
const shots = (await getOrdered('shots')).filter((s) => s.data.teaser);
---

<!-- No "See all" link until the Shots page exists (a later phase). -->
<section id="shots">
  <div class="wrap">
    <SectionTitle zh="攝影" title="Shots" />
    <p class="sec-sub shots-sub">{site.subtitles.shots}</p>
    <div class="shots-row">
      {
        shots.map(({ data }) => (
          <figure class="shot">
            <div class="frame">
              <Picture
                src={data.file}
                alt={data.alt}
                formats={['avif', 'webp']}
                width={960}
                widths={[480, 720, 960]}
                sizes="(max-width: 900px) 50vw, 25vw"
                loading="lazy"
              />
            </div>
            {!data.mine && data.credit && <figcaption>Photo: {data.credit}</figcaption>}
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initShots } from '../scripts/shots';
  initShots();
</script>

<style>
  .shots-sub {
    margin-bottom: 36px;
  }
  /* Grayscale until hover (or, on touch screens, until the middle of the screen). */
  .shots-row {
    display: grid;
    grid-template-columns: 1.35fr 0.75fr 1fr 1.2fr;
    gap: 14px;
  }
  .frame {
    overflow: hidden;
    border-radius: var(--r);
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: 360px;
    object-fit: cover;
    filter: var(--shot-filter);
    transition:
      filter 0.5s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .shot:hover .frame :global(img),
  .shot.in-view .frame :global(img) {
    filter: none;
    transform: scale(1.05);
  }
  figcaption {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 10px;
  }
  @media (prefers-reduced-motion: reduce) {
    .shot:hover .frame :global(img),
    .shot.in-view .frame :global(img) {
      transform: none;
    }
  }
  @media (max-width: 900px) {
    .shots-row {
      grid-template-columns: 1fr 1fr;
    }
    .frame :global(img) {
      height: 220px;
    }
  }
</style>

---
interface Props {
  /** The vertical Chinese label, decorative only. */
  zh: string;
  title: string;
  /** Contact's larger title. */
  big?: boolean;
  /** 1 on a page whose title this is (the Shots page); sections use 2. */
  level?: 1 | 2;
}

const { zh, title, big = false, level = 2 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<Heading class={big ? 'contact-big' : 'sec-title'}><span class="cjk" lang="zh-Hant" aria-hidden="true">{zh}</span>{title}</Heading>

---
// Link previews, the canonical URL, icons and a Person JSON-LD block (spec 14).
import { getEntry } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  /** For the 404 page. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const site = (await getEntry('site', 'site'))!.data;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL('/og.png', Astro.site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL('/', Astro.site).href,
  email: `mailto:${site.email}`,
  affiliation: { '@type': 'CollegeOrUniversity', name: 'The University of Texas at Austin' },
  sameAs: [site.links.github, site.links.linkedin, ...(site.links.scholar ? [site.links.scholar] : [])],
};
// Keep "</script>" from ever closing the block early.
const jsonLd = JSON.stringify(person).replace(/</g, '\\u003c');
---

{description && <meta name="description" content={description} />}
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name}: ${site.educationLine}`} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
{!noindex && <script type="application/ld+json" set:html={jsonLd} />}

---
import { getEntry } from 'astro:content';
import { getOrdered } from '../lib/content';
import SectionTitle from './SectionTitle.astro';

const site = (await getEntry('site', 'site'))!.data;
const projects = await getOrdered('projects');
---

<!-- Plain rows until Projects gets its own design (a later phase). -->
<section id="projects">
  <div class="wrap">
    <SectionTitle zh="作品" title="Projects" />
    <p class="sec-sub">{site.subtitles.projects}</p>
    {
      projects.map(({ data }) => (
        <div class="pj-row">
          <div>
            <h3 class="pj-title">
              {data.link ? (
                <a class="lt" href={data.link}>
                  {data.name}
                </a>
              ) : (
                data.name
              )}
            </h3>
            <p class="pj-desc">{data.description}</p>
            <p class="pj-tech">{data.tech.join(', ')}</p>
          </div>
          <span class="pj-year">{data.year}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .pj-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    padding: 32px 0;
    border-top: 1px solid var(--line);
  }
  .pj-title {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: -0.015em;
    font-size: clamp(32px, 3.4vw, 52px);
    line-height: 1.05;
  }
  .pj-desc {
    color: var(--text-2);
    font-size: 19.5px;
    margin-top: 10px;
    max-width: 60ch;
  }
  .pj-tech {
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--muted);
    margin-top: 10px;
  }
  .pj-year {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--muted);
  }
</style>

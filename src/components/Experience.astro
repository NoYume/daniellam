---
import { getCollection, getEntry } from 'astro:content';
import LineArt from './LineArt.astro';
import SectionTitle from './SectionTitle.astro';

const site = (await getEntry('site', 'site'))!.data;
const entries = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---

<section id="experience">
  <div class="wrap">
    <SectionTitle zh="經歷" title="Experience" />
    <p class="sec-sub">{site.subtitles.experience}</p>
    <div class="ex">
      <div>
        {
          entries.map(({ data }, i) => (
            <article class="ex-entry" data-art={i}>
              <div class="entry-media">
                <LineArt kind={data.art} uid={`ex-inline-${i}`} />
              </div>
              <h3 class="ex-co">{data.company}</h3>
              <div class="ex-meta">
                <span>{data.role}</span>
                <span>{data.dates}</span>
                <span>{data.place}</span>
              </div>
              <p class="ex-desc">{data.summary}</p>
              <ul class="ex-list">
                {data.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <div class="ex-art" id="exArt" aria-hidden="true">
        {entries.map(({ data }, i) => <LineArt kind={data.art} uid={`ex-${i}`} class={i === 0 ? 'on' : undefined} />)}
      </div>
    </div>
  </div>
</section>

<script>
  import { initPinned } from '../scripts/pinned';
  initPinned({ entries: '.ex-entry', panel: '#exArt', key: 'art' });
</script>

<style>
  /* Big serif company names; the drawing for the entry in the middle stays pinned on the right. */
  .ex {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(40px, 5vw, 88px);
    align-items: start;
  }
  .ex-entry {
    min-height: 84vh;
    padding: 7vh 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-bottom: 1px solid var(--line);
  }
  .ex-entry:last-child {
    border-bottom: 0;
  }
  .ex-co {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: -0.02em;
    font-size: clamp(54px, 6.4vw, 106px);
    line-height: 0.98;
    margin-bottom: 20px;
  }
  .ex-meta {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-bottom: 26px;
  }
  .ex-desc {
    font-size: clamp(23px, 2vw, 30px);
    line-height: 1.38;
    letter-spacing: -0.012em;
    margin-bottom: 22px;
    max-width: 32ch;
  }
  .ex-list li {
    font-size: 18.5px;
    color: var(--text-2);
    padding: 9px 0 9px 28px;
    position: relative;
    max-width: 56ch;
    line-height: 1.55;
  }
  .ex-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 22px;
    width: 13px;
    height: 1.5px;
    background: var(--acc);
  }
  .ex-art {
    position: sticky;
    top: 16vh;
    height: 68vh;
  }
  .ex-art :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: scale(0.97);
    transition:
      opacity 0.8s ease,
      transform 0.8s ease;
  }
  .ex-art :global(svg.on) {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .ex-art :global(svg) {
      transform: none;
    }
  }
  /* Phones (spec 9): each entry shows its own, smaller drawing above it; no pinned panel. */
  .entry-media {
    display: none;
  }
  @media (max-width: 900px) {
    .ex {
      grid-template-columns: 1fr;
    }
    .ex-art {
      display: none;
    }
    .ex-entry {
      min-height: auto;
      padding: 48px 0;
    }
    .entry-media {
      display: block;
      width: min(260px, 70%);
      aspect-ratio: 1 / 1;
      margin-bottom: 22px;
    }
    .entry-media :global(svg) {
      display: block;
      width: 100%;
      height: 100%;
    }
  }
</style>
